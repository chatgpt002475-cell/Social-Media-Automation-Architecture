# ========================================================
# Social Media Automation Architecture - Environment Configuration
# ========================================================

# Google Gemini API Key (Required for AI generation)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local Server & Scheduler Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
SECRET_KEY=local-dev-secret-key-change-in-prod
SCHEDULER_INTERVAL_SECONDS=30

# Webhook URLs (Optional: connect with Make.com, n8n, or Zapier)
MAKE_WEBHOOK_URL=
N8N_WEBHOOK_URL=
CUSTOM_WEBHOOK_URL=

# Facebook & Instagram Graph API (Optional for direct publishing)
# When left empty, system operates in Mock/Draft mode with full local payload exports
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_USER_ID=
IG_ACCESS_TOKEN=

# LinkedIn API (Optional)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Twitter / X API v2 (Optional)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Pinterest API v5 (Optional)
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
